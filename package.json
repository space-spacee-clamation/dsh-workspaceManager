{
  "name": "dsh-workspace-manager",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 并发工作区管理器：登记一个代码仓库和它的默认开发分支，一键克隆出新目录、拉出独立分支、注册进 DSH 工作区列表，并直接在那个工作区开会话；用完归档即从工作区列表移除。",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/space-spacee-clamation/dsh-workspaceManager.git"
  },
  "homepage": "https://github.com/space-spacee-clamation/dsh-workspaceManager",
  "bugs": {
    "url": "https://github.com/space-spacee-clamation/dsh-workspaceManager/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tools",
    "tests",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node tools/build.mjs && node --test \"tests/*.test.mjs\"",
    "install-profile": "node tools/install.mjs",
    "uninstall-profile": "node tools/install.mjs --uninstall"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT"
}
